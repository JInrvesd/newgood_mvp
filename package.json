{
  "name": "newgood-resume-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n BE,FE -c blue,green \"npm run dev:be\" \"npm run dev:fe\"",
    "dev:be": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:fe": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
